{
  "expo": {
    "name": "Pockit",
    "slug": "pockit",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "pockit",
    "extra": {
      "router": {
        "root": "src/app"
      }
    },
    "plugins": [
      "@ng-native/metro",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pockit uses your photos to add them to your vault.",
          "cameraPermission": "Pockit uses your camera to take photos of your documents."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pockit uses Face ID to confirm it's you before opening your vault."
        }
      ],
      "expo-sqlite"
    ]
  }
}
